# Required Telegram settings. Do not commit the real token.
TELEGRAM_BOT_TOKEN=1234567890:replace_me
TELEGRAM_ADMIN_USER_ID=123456789
TELEGRAM_TARGET_CHAT_ID=-1001234567890

# Persistent state.
DB_PATH=/var/lib/somonwatch/somonwatch.db
DEBUG_DIR=/var/lib/somonwatch/debug

# Runtime.
TZ=Asia/Dushanbe
LOG_LEVEL=info

# Somon polling. Keep the production interval at 10-30 minutes or slower.
SOMON_POLL_MIN=10m
SOMON_POLL_MAX=30m
SOMON_GAP_AFTER=45m
SOMON_BLOCK_BACKOFF=2h
SOMON_REQUEST_DELAY=900ms
HTTP_TIMEOUT=25s
SOMON_MIN_CARDS=20
SOMON_MAX_DETAILS_PER_POLL=20
SOMON_MAX_BODY_BYTES=10485760
SOMON_CATEGORY_URL=https://somon.tj/nedvizhimost/arenda-kvartir/dushanbe/
SOMON_USER_AGENT="SomonRentWatcher/1.0 (private Telegram notifier; low-rate polling)"

# Normally leave this unset. Useful only for a controlled Telegram-compatible proxy.
# TELEGRAM_API_BASE=https://api.telegram.org
